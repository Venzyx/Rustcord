{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustcord",
  "version": "0.1.0",
  "identifier": "dev.rustcord.app",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Rustcord",
    "shortDescription": "Lightweight Rust desktop shell for Discord",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false
      }
    }
  }
}
